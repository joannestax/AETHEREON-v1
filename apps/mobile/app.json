{
  "expo": {
    "name": "Aetheron",
    "slug": "aetheron",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "aetheron",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.origo.aetheron"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.origo.aetheron"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Aetheron \u2014 ORIGO Nexus",
      "shortName": "Aetheron",
      "description": "Finance God AI Mentor \u00b7 Project Genesis \u00b7 ORIGO Nexus",
      "themeColor": "#050508",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "baseUrl": "/AETHEREON-v1"
    }
  }
}
